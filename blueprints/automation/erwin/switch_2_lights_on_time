blueprint:
  name: Switch controls main or secondary light by time
  description: >
    A switch toggles your lights. When the switch is turned on, the main light
    comes on during the day, and the secondary light (e.g. a night light) comes
    on instead during the configured time window. Turning the switch off turns
    both lights off.
  domain: automation
  author: Erwin Everts
  homeassistant:
    min_version: 2026.10.0
  input:
    control_switch:
      name: Switch
      description: The switch that controls the lights.
      selector:
        entity:
          domain: switch
    main_light:
      name: Main light
      description: Turned on when the switch is on outside the secondary time window.
      selector:
        entity:
          domain: light
    secondary_light:
      name: Secondary light
      description: Turned on when the switch is on inside the secondary time window.
      selector:
        entity:
          domain: light
    secondary_start:
      name: Secondary light starts at
      description: From this time onwards the secondary light is used.
      default: "22:00:00"
      selector:
        time:
    secondary_end:
      name: Secondary light ends at
      description: From this time onwards the main light is used again.
      default: "06:00:00"
      selector:
        time:

mode: restart

trigger:
  - platform: state
    entity_id: !input control_switch
    to: "on"
    id: switch_on
  - platform: state
    entity_id: !input control_switch
    to: "off"
    id: switch_off

action:
  - choose:
      # Switch turned on
      - conditions:
          - condition: trigger
            id: switch_on
        sequence:
          - choose:
              # Inside the secondary time window -> secondary light
              - conditions:
                  - condition: time
                    after: !input secondary_start
                    before: !input secondary_end
                sequence:
                  - service: light.turn_off
                    target:
                      entity_id: !input main_light
                  - service: light.turn_on
                    target:
                      entity_id: !input secondary_light
            # Otherwise -> main light
            default:
              - service: light.turn_off
                target:
                  entity_id: !input secondary_light
              - service: light.turn_on
                target:
                  entity_id: !input main_light
      # Switch turned off -> everything off
      - conditions:
          - condition: trigger
            id: switch_off
        sequence:
          - service: light.turn_off
            target:
              entity_id:
                - !input main_light
                - !input secondary_light
